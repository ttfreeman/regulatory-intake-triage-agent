# Copy this file to .env and fill in your Gemini API key.
# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional overrides
GEMINI_MODEL=gemini-flash-latest
# If GEMINI_API_KEY is left blank, or the API call fails/times out, the agent
# automatically falls back to a deterministic, rule-based offline engine so the
# pipeline is always runnable end-to-end without network access. See
# README.md "Design Decisions" for why this fallback exists.

# Troubleshooting: on a corporate network with TLS inspection you may see
# CERTIFICATE_VERIFY_FAILED. If so, set SSL_CERT_FILE to your system CA bundle,
# e.g. (Linux): export SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
